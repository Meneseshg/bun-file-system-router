generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int       @id @default(autoincrement())
  nombre        String?
  email         String?
  fechaRegistro DateTime? @map("fecha_registro")
  puntos        Int?

  @@map("usuarios")
}
